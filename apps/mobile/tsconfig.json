{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@bureau/api": ["../../packages/api/src/index.ts"],
      "@bureau/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/types/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
