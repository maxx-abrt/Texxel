# ---------------------------------------------------------------------------
# apps/web — environment template. Copy to `.env.local` (never commit secrets).
# The same keys must exist in the Vercel project (Production + Preview).
# ---------------------------------------------------------------------------

# --- This app's own Convex deployment -------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://veracious-reindeer-573.eu-west-1.convex.cloud
CONVEX_DEPLOYMENT=prod:veracious-reindeer-573
# CONVEX_DEPLOY_KEY=            # Vercel only (used by `npx convex deploy`)

# --- A2E Core (shared suite backend) --------------------------------------
# Identity, workspaces, memberships, roles, entitlements, drive, calendar,
# tasks, contacts, notifications, activities, comments, links, intents,
# shares, presence, prefs, federated search.
NEXT_PUBLIC_CONVEX_CORE_URL=https://superb-grasshopper-152.eu-west-1.convex.cloud

# Core-first module flags. Default = ON (see lib/core-flags.ts); set to 0 to
# fall back to this app's legacy local tables for a module.
NEXT_PUBLIC_A2E_CORE_NOTIFICATIONS=1
NEXT_PUBLIC_A2E_CORE_EVENTS=1
NEXT_PUBLIC_A2E_CORE_TASKS=1
NEXT_PUBLIC_A2E_CORE_PRESENCE=1
NEXT_PUBLIC_A2E_CORE_PREFS=1
NEXT_PUBLIC_A2E_CORE_SEARCH=1
NEXT_PUBLIC_A2E_CORE_QUOTAS=1
NEXT_PUBLIC_A2E_CORE_ROLES=1
NEXT_PUBLIC_A2E_CORE_ACTIVITIES=1
NEXT_PUBLIC_A2E_CORE_CONTACTS=1
NEXT_PUBLIC_A2E_DRIVE=1

# --- WorkOS AuthKit (this app's own WorkOS application) -------------------
WORKOS_CLIENT_ID=client_xxx
WORKOS_API_KEY=sk_xxx
WORKOS_COOKIE_PASSWORD=change_me_min_32_chars_long_secret
WORKOS_REDIRECT_URI=https://texxel.app/callback
NEXT_PUBLIC_APP_URL=https://texxel.app

# --- Server-side only, on the CONVEX deployment (npx convex env set) ------
# Needed by convex/coreSync.ts (the §12.1 service bridge). NOT a Vercel var.
# A2E_SERVICE_SECRET=...
# CONVEX_CORE_URL=https://superb-grasshopper-152.eu-west-1.convex.cloud

# --- Optional integrations -------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM=
# GEMINI_API_KEY=
# AIML_API_KEY=
