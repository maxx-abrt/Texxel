{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "VERCEL", "VERCEL_ENV"],
  "globalPassThroughEnv": [
    "NEXT_PUBLIC_CONVEX_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD",
    "CONVEX_DEPLOYMENT",
    "CONVEX_DEPLOY_KEY",
    "RESEND_API_KEY",
    "RESEND_FROM",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_CONVEX_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
