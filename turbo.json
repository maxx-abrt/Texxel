{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "VERCEL", "VERCEL_ENV"],
  "globalPassThroughEnv": [
    "NEXT_PUBLIC_CONVEX_URL",
    "NEXT_PUBLIC_CONVEX_CORE_URL",
    "NEXT_PUBLIC_CONVEX_SITE_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "NEXT_PUBLIC_A2E_CORE_NOTIFICATIONS",
    "NEXT_PUBLIC_A2E_CORE_EVENTS",
    "NEXT_PUBLIC_A2E_CORE_TASKS",
    "NEXT_PUBLIC_A2E_CORE_PRESENCE",
    "NEXT_PUBLIC_A2E_CORE_PREFS",
    "NEXT_PUBLIC_A2E_CORE_SEARCH",
    "NEXT_PUBLIC_A2E_CORE_QUOTAS",
    "NEXT_PUBLIC_A2E_CORE_ROLES",
    "NEXT_PUBLIC_A2E_CORE_ACTIVITIES",
    "NEXT_PUBLIC_A2E_CORE_CONTACTS",
    "NEXT_PUBLIC_A2E_DRIVE",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD",
    "CONVEX_DEPLOYMENT",
    "CONVEX_DEPLOY_KEY",
    "CONVEX_CORE_URL",
    "A2E_SERVICE_SECRET",
    "RESEND_API_KEY",
    "RESEND_FROM",
    "EDGE_STORE_ACCESS_KEY",
    "EDGE_STORE_SECRET_KEY",
    "AIML_API_KEY",
    "GEMINI_API_KEY",
    "WORKOS_REDIRECT_URI",
    "DATABASE_URL",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_CONVEX_URL",
    "EXPO_PUBLIC_CONVEX_CORE_URL",
    "EXPO_PUBLIC_WORKOS_CLIENT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
